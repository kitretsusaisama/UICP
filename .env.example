# =============================================================================
# UICP - Multi-Tenant Communication Platform
# =============================================================================
# Copy to .env and configure for your environment
# NEVER commit .env to version control
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# APPLICATION SETTINGS
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
PORT_POOL_SIZE=100
SERVICE_NAME=uicp
SERVICE_VERSION=1.0.0
# Comma-separated allowed browser origins. Required in production; omit only for local dev.
CORS_ORIGIN=https://app.uicp.example
# Set true only for controlled environments; Swagger is disabled by default in production.
SWAGGER_ENABLED=false
# Optional OpenTelemetry tracing.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# Optional internal-service and OIDC settings.
INTERNAL_TOKEN=REPLACE_WITH_INTERNAL_SERVICE_TOKEN
OIDC_ISSUER=https://your-domain.com
AUDIT_HMAC_KEY=REPLACE_WITH_64_CHAR_HEX_VALUE

# ─────────────────────────────────────────────────────────────────────────────
# MYSQL DATABASE
# ─────────────────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=uicp
DB_USER=uicp_user
DB_PASSWORD=change_me_in_production
DB_POOL_MIN=5
DB_POOL_MAX=20
# Legacy mysql2 pool aliases still referenced by DatabaseModule.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=uicp
MYSQL_USER=uicp_user
MYSQL_PASSWORD=change_me_in_production
MYSQL_REPLICA_HOST=
MYSQL_REPLICA_PORT=
MYSQL_REPLICA_DB=
MYSQL_REPLICA_USER=
MYSQL_REPLICA_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# REDIS (Cache + Sessions)
# ─────────────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_CLUSTER=false

# ─────────────────────────────────────────────────────────────────────────────
# BULLMQ QUEUE SETTINGS
# ─────────────────────────────────────────────────────────────────────────────
# BullMQ uses Redis connection above
QUEUE_CONCURRENCY=10
QUEUE_MAX_COMPLETED=1000
QUEUE_REMOVE_COMPLETED_AFTER_MS=3600000

# ─────────────────────────────────────────────────────────────────────────────
# MSG91 SMS PROVIDER
# ─────────────────────────────────────────────────────────────────────────────
MSG91_ENABLED=true
MSG91_AUTH_KEY=your_msg91_api_key_here
MSG91_SENDER_ID=YOUR_SENDER_ID
MSG91_ROUTE=4
MSG91_COUNTRY=91
MSG91_TEMPLATE_ID_IDENTITY_VERIFICATION=your_template_id
MSG91_TEMPLATE_ID_MFA=your_template_id
MSG91_TEMPLATE_ID_PASSWORD_RESET=your_template_id
MSG91_WEBHOOK_AUTH_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# RESEND EMAIL PROVIDER
# ─────────────────────────────────────────────────────────────────────────────
RESEND_ENABLED=true
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=noreply@yourdomain.com
RESEND_FROM_NAME=Your Company Name
RESEND_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# MAILEROO EMAIL PROVIDER
# ─────────────────────────────────────────────────────────────────────────────
MAILEROO_ENABLED=true
MAILEROO_API_KEY=your_maileroo_api_key
MAILEROO_FROM=noreply@yourdomain.com
MAILEROO_FROM_NAME=Your Company Name
MAILEROO_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# JWT AUTHENTICATION
# ─────────────────────────────────────────────────────────────────────────────
JWT_PRIVATE_KEY_ENC=
# Raw PEM private key for local/CI only. Prefer JWT_PRIVATE_KEY_ENC in production.
JWT_PRIVATE_KEY=REPLACE_WITH_ESCAPED_PEM_PRIVATE_KEY
JWT_PUBLIC_KEY=
JWT_KID=key-v1
JWT_ISSUER=https://your-domain.com
JWT_AUDIENCE=uicp-api
JWT_ACCESS_TOKEN_TTL_S=900
JWT_REFRESH_TOKEN_TTL_S=604800
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32

# ─────────────────────────────────────────────────────────────────────────────
# ENCRYPTION KEYS
# ─────────────────────────────────────────────────────────────────────────────
ENCRYPTION_MASTER_KEY=generate_with_openssl_rand_hex_32
ENCRYPTION_MASTER_KEY_ID=master-v1

# ─────────────────────────────────────────────────────────────────────────────
# PASSWORD HASHING
# ─────────────────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
PASSWORD_PEPPER=generate_with_openssl_rand_base64_32

# ─────────────────────────────────────────────────────────────────────────────
# SESSION SETTINGS
# ─────────────────────────────────────────────────────────────────────────────
SESSION_TTL_S=86400
MAX_SESSIONS_PER_USER=10

# ─────────────────────────────────────────────────────────────────────────────
# OTP SETTINGS
# ─────────────────────────────────────────────────────────────────────────────
OTP_TTL_S=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=3
OTP_RETRY_DELAY_S=30
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_PASSWORD=
SMTP_FROM=noreply@uicp.local
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
MSG91_WIDGET_ID=
MSG91_TOKEN_AUTH=
MSG91_FLOW_ID_IDENTITY=
MSG91_FLOW_ID_MFA=
MSG91_FLOW_ID_PASSWORD_RESET=
WIDGET_SIGNATURE_SECRET=REPLACE_WITH_WIDGET_SIGNATURE_SECRET
BULLMQ_MAX_QUEUE_LEN=10000
BULLMQ_QUEUE_LEN_SAMPLE_RATE=0.05

# ───────────────��─────────────────────────────────────────────────────────────
# TENANT DEFAULTS
# ─────────────────────────────────────────────────────────────────────────────
# Default rate limits for new tenants
DEFAULT_RATE_LIMIT_PER_MIN=50
DEFAULT_DAILY_LIMIT=5000
DEFAULT_MONTHLY_LIMIT=100000

# ─────────────────────────────────────────────────────────────────────────────
# CIRCUIT BREAKER SETTINGS
# ─────────────────────────────────────────────────────────────────────────────
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RESET_TIMEOUT_MS=60000
CIRCUIT_SUCCESS_THRESHOLD=3

# ─────────────────────────────────────────────────────────────────────────────
# RETRY SETTINGS
# ─────────────────────────────────────────────────────────────────────────────
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=60000

# ─────────────────────────────────────────────────────────────────────────────
# WEBHOOKS
# ─────────────────────────────────────────────────────────────────────────────
APP_BASE_URL=https://your-domain.com
WEBHOOK_SIGNATURE_SECRET=generate_with_openssl_rand_hex_32

# ─────────────────────────────────────────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────────────────────────────────────────
GLOBAL_RATE_LIMIT_PER_MIN=1000

# ─────────────────────────────────────────────────────────────────────────────
# TENANT SPECIFIC CONFIGURATIONS
# ─────────────────────────────────────────────────────────────────────────────
# Format: TENANT_{ID}_PROVIDERS=SMS:provider_key,EMAIL:provider_key
# Example: TENANT_A_PROVIDERS=SMS:MSG91,EMAIL:RESEND
# TENANT_A_PROVIDERS=SMS:MSG91,EMAIL:RESEND
# TENANT_B_PROVIDERS=SMS:TWILIO,EMAIL:MAILEROO

# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION SECRETS (Generate These!)
# ─────────────────────────────────────────────────────────────────────────────
# Run these commands to generate secure values:
#
# openssl rand -hex 32
# openssl rand -base64 32
#
# Then paste the generated values above.
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# ENTERPRISE API KEY SYSTEM (v2 - ULID-based)
# ─────────────────────────────────────────────────────────────────────────────
# HMAC secret for API key signature verification (REQUIRED - min 32 chars)
# Generate with: openssl rand -hex 32
API_KEY_HMAC_SECRET=REPLACE_WITH_64_CHAR_HEX_VALUE
# Comma-separated internal service tokens for service-to-service auth
INTERNAL_SERVICE_TOKENS=svc_token_1,svc_token_2
# Platform API key HMAC (if different from main API_KEY_HMAC_SECRET)
PLATFORM_API_KEY_HMAC_SECRET=
